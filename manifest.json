{
  "manifest_version": 3,
  "name": "Browser Tab & Bookmark Migrator",
  "version": "1.0.0",
  "description": "Migrate tabs, groups, and bookmarks between Chromium-based browsers, Firefox, and Safari.",
  "permissions": [
    "tabGroups",
    "tabs",
    "bookmarks",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}